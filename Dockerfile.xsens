# XSENS IMU
FROM ros:jazzy-ros-base

# Fix apt mirrors
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-rosinstall-generator \
    python3-vcstool \
    wget \
    unzip \
    ncurses-dev
    
# Copy only norlab_xsens_driver package, install its dependencies, then clean up
COPY ./docker_ws/src/norlab_xsens_driver /tmp/docker_ws_build/src/norlab_xsens_driver
RUN rosdep update && \
    rosdep install --from-paths /tmp/docker_ws_build/src/norlab_xsens_driver -y --ignore-src 2>/dev/null || true && \
    pip3 install pyserial transforms3d && \
    rm -rf /tmp/docker_ws_build && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /docker_ws

COPY ./docker_entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "ros2", "launch", "xsens_driver", "xsens_driver.launch.xml"]