#RECORDING
FROM ros2-apparatus-base:jazzy AS recording

RUN apt update --fix-missing

WORKDIR /docker_ws/src/

RUN apt update --fix-missing

RUN git clone -b ros2 --recurse-submodules https://github.com/ouster-lidar/ouster-ros.git

RUN git clone https://github.com/tu-darmstadt-ros-pkg/hector_recorder.git

RUN git clone https://github.com/IntelRealSense/realsense-ros.git

RUN rosdep install --from-paths . -y --ignore-src

WORKDIR /docker_ws/

RUN . /opt/ros/$ROS_DISTRO/setup.sh && colcon build --packages-up-to ouster_ros hector_recorder hector_recorder_msgs

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]