#RECORDING
FROM ros2-apparatus-base:jazzy AS recording

WORKDIR /docker_ws/src/

RUN apt update --fix-missing

RUN rm -rf ouster-ros && \
    git clone -b ros2 --filter=blob:none --no-checkout https://github.com/errorcodecritical/ouster-ros && \
    cd ouster-ros && \
    git sparse-checkout set --cone ouster-sensor-msgs && \
    git checkout ros2

RUN git clone https://github.com/tu-darmstadt-ros-pkg/hector_recorder.git

RUN git clone https://github.com/IntelRealSense/realsense-ros.git

RUN rosdep update && rosdep install --from-paths . -y --ignore-src

WORKDIR /docker_ws/

RUN apt install -y libboost-all-dev

RUN . /opt/ros/$ROS_DISTRO/setup.sh && colcon build --packages-up-to ouster_sensor_msgs hector_recorder hector_recorder_msgs

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]