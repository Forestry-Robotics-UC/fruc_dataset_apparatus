#STATE PUBLISHER
FROM ros:jazzy-ros-base

RUN apt update --fix-missing && apt install -y \
    build-essential \
    cmake \
    git \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-rosinstall-generator \
    python3-vcstool \
    ros-jazzy-xacro \
    ros-jazzy-rviz2 \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher-gui \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /docker_ws/src/

COPY docker_build/apparatus_description apparatus_description

WORKDIR /docker_ws/

# Build the workspace
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install

COPY ./docker_build/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "ros2", "launch", "apparatus_description", "robot_state_publisher.launch.py" ]