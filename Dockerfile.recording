#RECORDING
FROM ros:jazzy-ros-base

# Fix apt mirrors
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-rosinstall-generator \
    python3-vcstool \
    unzip \
    wget \
    ncurses-dev \
    libboost-all-dev

# Copy only hector_recorder package, install its dependencies, then clean up
COPY ./docker_ws/src/hector_recorder /tmp/docker_ws_build/src/hector_recorder
RUN rosdep update && \
    rosdep install --from-paths /tmp/docker_ws_build/src/hector_recorder -y --ignore-src 2>/dev/null || true && \
    rm -rf /tmp/docker_ws_build && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /docker_ws

COPY ./docker_entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]