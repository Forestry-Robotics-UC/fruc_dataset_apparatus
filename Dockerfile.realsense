FROM ros:jazzy-ros-base

# Install dependencies
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://azure.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources

RUN apt-get update && \
    apt-get install -y \
    build-essential \
    git \
    cmake \
    wget \
    python3-rosdep \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libglfw3-dev \
    libusb-1.0-0-dev \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-compressed-image-transport \
    ros-jazzy-diagnostic-updater \
    ros-jazzy-sensor-msgs \
    ros-jazzy-std-srvs

# Clone and build librealsense with DKMS
WORKDIR /tmp/
RUN git clone https://github.com/IntelRealSense/librealsense.git --single-branch

WORKDIR /tmp/librealsense/build
RUN mkdir -p /tmp/librealsense/build
RUN cmake .. -DFORCE_RSUSB_BACKEND=true -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    ldconfig

# Set up workspace
WORKDIR /docker_ws

COPY ./docker_entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
